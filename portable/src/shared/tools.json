  {
    "name": "use_batch",
    "description": "Execute 1–12 known semantic steps sequentially on a fresh observation. Stops on first error, ambiguity, uncertainty or timeout. Completed steps are retained; no rollback, replay or automatic resume. Use stable selectors without positional IDs or coordinates. Reconcile uncertain child request IDs after checking the actual screen. Retrieve pending job_id with use_job_result; never resubmit input to poll.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "maxLength": 256
        },
        "observation_id": {
          "type": "string",
          "maxLength": 256
        },
        "device_id": {
          "type": "string",
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "click",
                      "long_click",
                      "focus",
                      "set_text",
                      "selection",
                      "select",
                      "scroll",
                      "key"
                    ]
                  },
                  "selector": {
                    "type": "object",
                    "properties": {
                      "resource_id": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "text": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "role": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "occurrence": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  },
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  },
                  "duration_ms": {
                    "type": "integer"
                  },
                  "scroll_x": {
                    "type": "integer"
                  },
                  "scroll_y": {
                    "type": "integer"
                  },
                  "click_count": {
                    "type": "integer"
                  },
                  "key": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "mode": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "direction": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "button": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "action": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 65536
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              "wait_for": {
                "type": "object",
                "properties": {
                  "resource_id": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "role": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "occurrence": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "wait_timeout_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        }
      },
      "required": [
        "device_id",
        "request_id",
        "session_id",
        "observation_id",
        "steps"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
  }
