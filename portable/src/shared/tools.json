  {
    "name": "use_action",
    "description": "Execute one action bound to a fresh observation. Selectors must identify one node; occurrence is zero-based. Text replace accepts empty string; append/insert require a verified native field value. Never replay an uncertain action.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "maxLength": 256
        },
        "observation_id": {
          "type": "string",
          "maxLength": 256
        },
        "action": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "click",
                "long_click",
                "focus",
                "set_text",
                "selection",
                "select",
                "scroll",
                "key",
                "gesture",
                "secondary",
                "drag"
              ]
            },
            "selector": {
              "type": "object",
              "properties": {
                "node_id": {
                  "type": "string",
                  "maxLength": 256
                },
                "resource_id": {
                  "type": "string",
                  "maxLength": 256
                },
                "text": {
                  "type": "string",
                  "maxLength": 256
                },
                "description": {
                  "type": "string",
                  "maxLength": 256
                },
                "role": {
                  "type": "string",
                  "maxLength": 256
                },
                "parent_id": {
                  "type": "string",
                  "maxLength": 256
                },
                "window_id": {
                  "type": "string",
                  "maxLength": 256
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "duration_ms": {
              "type": "integer"
            },
            "scroll_x": {
              "type": "integer"
            },
            "scroll_y": {
              "type": "integer"
            },
            "click_count": {
              "type": "integer"
            },
            "from_x": {
              "type": "integer"
            },
            "from_y": {
              "type": "integer"
            },
            "to_x": {
              "type": "integer"
            },
            "to_y": {
              "type": "integer"
            },
            "key": {
              "type": "string",
              "maxLength": 256
            },
            "mode": {
              "type": "string",
              "maxLength": 256
            },
            "direction": {
              "type": "string",
              "maxLength": 256
            },
            "button": {
              "type": "string",
              "maxLength": 256
            },
            "action": {
              "type": "string",
              "maxLength": 256
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 120,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "device_id": {
          "type": "string",
          "maxLength": 256
        },
        "request_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "session_id",
        "observation_id",
        "action",
        "device_id",
        "request_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
