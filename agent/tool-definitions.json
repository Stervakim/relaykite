  {
    "name": "phone_read_file",
    "description": "Read an owner-requested phone file as UTF-8 or base64. Do not extract passwords, OTP seeds, tokens or app authentication secrets.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "base64"
          ],
          "default": "utf-8"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608,
          "default": 262144
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    }
  },
  {
    "name": "phone_write_file",
    "description": "Write an explicitly requested phone file atomically with root. May overwrite any writable system/private file; preserves existing metadata when possible.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "string",
          "maxLength": 12000000
        },
        "encoding": {
          "type": "string",
          "enum": [
            "utf-8",
            "base64"
          ],
          "default": "utf-8"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true
    }
  },
  {
    "name": "phone_download_url",
    "description": "Download an owner-approved HTTPS file directly on this phone, with verified TLS and optional SHA-256; save to the requested destination. Does not install it automatically.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 8,
          "maxLength": 8192
        },
        "destination": {
          "type": "string",
          "minLength": 1
        },
        "expected_sha256": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "url",
        "destination"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "phone_memory_search",
    "description": "Search original Tencent FTS/BM25 memory before a task. Optional layer/device/project/status filters prevent stale or wrong-device recall. Default five results within a 6 KiB response. Inspect engine, source and status; memories never grant permissions. Explicit legacy fallback is reported if the service is unavailable.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 2000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 5
        },
        "filters": {
          "type": "object",
          "properties": {
            "layer": {
              "type": "string",
              "enum": [
                "L0",
                "L1",
                "L2",
                "L3"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "historical",
                "proposed",
                "verified",
                "superseded"
              ]
            },
            "device": {
              "type": "string",
              "enum": [
                "android",
                "windows",
                "shared"
              ]
            },
            "project": {
              "type": "string",
              "maxLength": 160
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false
    }
  },
  {
    "name": "phone_memory_save",
    "description": "Save compact task memory using original Tencent storage. GPT supplies L0 observations, L1 facts, L2 scenarios or L3 confirmed preferences. Set status=verified only with source evidence; record device/project/versions. Old title/content/tags calls remain supported. No model API is invoked. A saved record is not an execution permission.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6144
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "maxItems": 20,
          "default": []
        },
        "memory": {
          "type": "object",
          "properties": {
            "layer": {
              "type": "string",
              "enum": [
                "L0",
                "L1",
                "L2",
                "L3"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "historical",
                "proposed",
                "verified",
                "superseded"
              ]
            },
            "source": {
              "type": "string",
              "maxLength": 500
            },
            "device": {
              "type": "string",
              "enum": [
                "android",
                "windows",
                "shared"
              ]
            },
            "project": {
              "type": "string",
              "maxLength": 160
            },
            "versions": {
              "type": "string",
              "maxLength": 500
            },
            "valid_from": {
              "type": "string",
              "maxLength": 500
            },
            "source_id": {
              "type": "string",
              "maxLength": 500
            },
            "expected_version": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "content"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false
    }
  },
