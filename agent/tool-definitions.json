        "memory": {
          "type": "object",
          "properties": {
            "layer": {
              "type": "string",
              "enum": [
                "L0",
                "L1",
                "L2",
                "L3"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "historical",
                "proposed",
                "verified",
                "superseded"
              ]
            },
            "source": {
              "type": "string",
              "maxLength": 500
            },
            "device": {
              "type": "string",
              "enum": [
                "android",
                "windows",
                "shared"
              ]
            },
            "project": {
              "type": "string",
              "maxLength": 160
            },
            "versions": {
              "type": "string",
              "maxLength": 500
            },
            "valid_from": {
              "type": "string",
              "maxLength": 500
            },
            "source_id": {
              "type": "string",
              "maxLength": 500
            },
            "expected_version": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "content"
      ],
      "additionalProperties": false
